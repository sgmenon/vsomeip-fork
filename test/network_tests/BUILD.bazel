load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//test:__subpackages__"])

cc_library(
    name = "someip_test_globals",
    testonly = True,
    hdrs = ["someip_test_globals.hpp"],
    includes = ["."],
    deps = ["//:vsomeip-lib"],
)
