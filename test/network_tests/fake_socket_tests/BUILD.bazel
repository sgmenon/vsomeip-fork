#
# In-process network tests that inject fake TCP sockets (no real NICs /
# multi-host required). CMake equivalent:
#   test/network_tests/fake_socket_tests/CMakeLists.txt

load("@rules_cc//cc:defs.bzl", "cc_test")

# JSON has no @VAR@ substitutions; ship the .in content as the runtime config.
filegroup(
    name = "fake_socket_configs",
    testonly = True,
    srcs = ["conf/multiple_client_one_process.json.in"],
)

cc_test(
    name = "fake_socket_tests",
    srcs = glob([
        "*.cpp",
        "helpers/*.cpp",
        "helpers/*.hpp",
    ]),
    # use_configuration() setenv(..., overwrite=0), so a pre-set path wins.
    data = [":fake_socket_configs"],
    env = {
        "VSOMEIP_CONFIGURATION": "$(rootpath :fake_socket_configs)",
    },
    includes = [
        ".",
        "helpers",
    ],
    # Keep libvsomeip3-sd.so.3 as DT_NEEDED even though the test never
    # references an SD symbol directly — plugin_manager dlopens that soname.
    linkopts = [
        "-Wl,--no-as-needed",
        "-Wl,-rpath,$$ORIGIN",
    ],
    deps = [
        "//:vsomeip-lib",
        "//:vsomeip-sd",
        "//test/common:vsomeip_utilities",
        "@boost.asio",
        "@boost.system",
        "@googletest//:gtest",
    ],
)
